{
  "name": "@yunzai-ng/adapter-icqq",
  "version": "0.1.0",
  "description": "ICQQ 适配器：以 icqq 协议库直连 QQ，面板内扫码 / 密码登录，滑块、设备锁验证",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Yunzai-NG",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "yunzai": {
    "name": "adapter-icqq"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "tsc -b",
    "build:clean": "tsc -b --clean",
    "link:framework": "node scripts/link-framework.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "pnpm run build && pnpm run typecheck:test && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@yunzai-ng/core": ">=0.2.0",
    "@yunzai-ng/types": ">=0.1.1"
  },
  "dependencies": {
    "icqq": "0.6.10",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-plugin-jsdoc": "^50.6.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
